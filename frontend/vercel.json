{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://phobiabot.onrender.com/api/:path*"
    },
    {
      "source": "/static/css/:path*",
      "destination": "/css/:path*"
    },
    {
      "source": "/static/js/:path*",
      "destination": "/js/:path*"
    }
  ]
}
